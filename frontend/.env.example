# CivicResolve AI Frontend Environment Configuration
# Copy this file to .env.local for local overrides.
# DO NOT COMMIT SECRETS OR SENSITIVE PASSWORDS TO ANY .env FILE.

# Base URL for API calls.
# In local development, leave empty or set to "" to route through Vite's /api proxy to avoid CORS.
# In production, set to your backend origin (e.g., https://api.civicresolve.example.com) or leave empty if served via reverse proxy.
VITE_API_BASE_URL=

# Vite development server proxy target (used in vite.config.ts)
# Defaults to Spring Boot local server on port 8080
VITE_API_PROXY_TARGET=http://localhost:8080

